# OpenAI-compatible model server (Colab tunnel or local GPU).
# Use http://127.0.0.1:8000/v1 when the model server runs on this machine.
LLM_BASE_URL=http://127.0.0.1:8000/v1
# Optional split endpoints if text and vision run on two separate Colab tunnels:
# LLM_TEXT_BASE_URL=https://text-tunnel.trycloudflare.com/v1
# LLM_VISION_BASE_URL=https://vision-tunnel.trycloudflare.com/v1
LLM_API_KEY=

# Separate models loaded by the backend (both | text | vision).
LLM_LOAD_MODE=both
LLM_TEXT_MODEL=Qwen/Qwen2.5-3B-Instruct
LLM_VISION_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
LLM_QUANTIZE=false
LLM_QUANT_BITS=8
LLM_TEXT_DEVICE=cuda

# Wardrobe AI Photo Scanner:
# - true → intentional deterministic demo JSON
# - false → call /v1/wardrobe/scan; live failures return an error
WARDROBE_SCAN_MOCK=true

STYLIST_DEBUG=true

# Optional. Not required for Qwen2.5-VL anonymous download.
# HF_TOKEN=

# Remote teammate hosting via Tailscale Funnel -> Render Static Site
# Comma-separated browser origins allowed to call this PC's Node API:
# ALLOWED_ORIGINS=https://your-site.onrender.com
# TAILSCALE_FUNNEL_URL=https://your-pc.your-tailnet.ts.net
# AI_SERVER_HOST=127.0.0.1
# HOST=127.0.0.1
#
# Frontend build variable (set in Render Static Site Environment Variables):
# VITE_API_BASE_URL=https://your-pc.your-tailnet.ts.net

# Google Calendar private .ics feed (Node fetches server-side to avoid CORS).
# Calendar → Settings → Integrate calendar → Secret address in iCalendar format.
# Leave unset to use demo events; users can also upload a .ics file in Ask AI.
# GOOGLE_CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/.../basic.ics
