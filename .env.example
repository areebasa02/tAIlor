# OpenAI-compatible model server (Colab tunnel or local GPU).
# Use http://127.0.0.1:8000/v1 when the model server runs on this machine.
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=

# Separate models loaded by the Colab backend.
LLM_TEXT_MODEL=Qwen/Qwen2.5-3B-Instruct
LLM_VISION_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
LLM_QUANTIZE=false
LLM_TEXT_DEVICE=cuda

# Wardrobe AI Photo Scanner:
# - true → intentional deterministic demo JSON
# - false → call Colab /v1/wardrobe/scan; live failures return an error
WARDROBE_SCAN_MOCK=true

STYLIST_DEBUG=true

# Optional. Not required for Qwen2.5-VL anonymous download.
# HF_TOKEN=
