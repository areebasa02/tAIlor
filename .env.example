# OpenAI-compatible model server (Colab tunnel or local GPU).
# Use http://127.0.0.1:8000/v1 when the model server runs on this machine.
LLM_BASE_URL=http://127.0.0.1:8000/v1
# Optional split endpoints if text and vision run on two separate Colab tunnels:
# LLM_TEXT_BASE_URL=https://text-tunnel.trycloudflare.com/v1
# LLM_VISION_BASE_URL=https://vision-tunnel.trycloudflare.com/v1
LLM_API_KEY=

# Separate models loaded by the backend (both | text | vision).
LLM_LOAD_MODE=both
LLM_TEXT_MODEL=Qwen/Qwen2.5-3B-Instruct
LLM_VISION_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
# On 24 GB+ GPUs with TRYON_PRELOAD=true, colab_server.py automatically loads Qwen2.5-3B in 8-bit
# so Qwen Text + Qwen VL + RealVisXL V5 Lightning + ControlNet Union + FastFit-MR-1024 all stay warm in VRAM.
LLM_QUANTIZE=true
LLM_QUANT_BITS=8
LLM_TEXT_DEVICE=cuda

# Hybrid 2-Stage Virtual Try-On (Stage 1: Pose/Depth ControlNet Union -> Stage 2: FastFit-MR-1024 VTON)
TRYON_SDXL_MODEL=SG161222/RealVisXL_V5.0_Lightning
TRYON_CONTROLNET_UNION_MODEL=OzzyGT/controlnet-union-promax-sdxl-1.0
TRYON_FASTFIT_MODEL=zhengchong/FastFit-MR-1024
# Note: FastFit-MR-1024 is licensed strictly for Non-Commercial Academic / Research use (see .licenses/FASTFIT_LICENSE.md).
# Set TRYON_STAGE2_VTON=sdxl_only (or COMMERCIAL_PRODUCTION_MODE=true) if deploying for commercial end-user production.
TRYON_STAGE2_VTON=fastfit
TRYON_FASTFIT_STEPS=24
TRYON_PRELOAD=true

# Wardrobe AI Photo Scanner:
# - true → intentional deterministic demo JSON
# - false → call /v1/wardrobe/scan; live failures return an error
WARDROBE_SCAN_MOCK=true

STYLIST_DEBUG=true

# Optional. Not required for Qwen2.5-VL, RealVisXL, ControlNetUnion, or FastFit anonymous download.
# HF_TOKEN=

# Remote teammate hosting via Tailscale Funnel -> Render Static Site
# Comma-separated browser origins allowed to call this PC's Node API:
# ALLOWED_ORIGINS=https://your-site.onrender.com
# TAILSCALE_FUNNEL_URL=https://your-pc.your-tailnet.ts.net
# AI_SERVER_HOST=127.0.0.1
# HOST=127.0.0.1
#
# Frontend build variable (set in Render Static Site Environment Variables):
# VITE_API_BASE_URL=https://your-pc.your-tailnet.ts.net
#
# Calendar on Render:
# - Upload .ics / Google .zip works in the browser with NO backend (Static Site is fine).
# - Connect URL (for CORS-restricted feeds like Google/Apple/Outlook) & GOOGLE_CALENDAR_ICS_URL
#   use the Node API: set VITE_API_BASE_URL to a reachable host running server/server.mjs,
#   or deploy as a Web Service with start command `pnpm start` (serves dist/ + /api).
# - GOOGLE_CALENDAR_ICS_URL is a server runtime env var (Node process), not VITE_*.

# Google Calendar private .ics feed (Node fetches server-side to avoid CORS).
# Calendar → Settings → Integrate calendar → Secret address in iCalendar format.
# Leave unset to use persona demo events; users can also upload a .ics/.zip file on the Calendar tab.
# GOOGLE_CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/.../basic.ics
