# OpenAI-compatible model server (Colab tunnel or local GPU).
# Append /v1 to the cloudflared URL printed by tailorbackend.ipynb.
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=

# Vision model for wardrobe photo scan (+ text stylist when using VL).
# Qwen2.5-VL downloads anonymously — HF_TOKEN is optional.
LLM_MODEL=Qwen/Qwen2.5-VL-3B-Instruct

# Wardrobe AI Photo Scanner:
# - omit / true → deterministic demo JSON (works without GPU / Colab)
# - false → call Colab /v1/wardrobe/scan (requires live LLM_BASE_URL)
WARDROBE_SCAN_MOCK=true

STYLIST_DEBUG=true

# Optional. Not required for Qwen2.5-VL anonymous download.
# HF_TOKEN=
